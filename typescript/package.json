{
  "name": "@pleaxy/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript client for the Pleaxy API: purchase orders, invoices and settlement for cloud spend.",
  "license": "MIT",
  "homepage": "https://pleaxy.ai/sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pleaxyai/pleaxy-sdk.git",
    "directory": "typescript"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "openapi-typescript ../openapi/pleaxy.json -o src/schema.ts && node scripts/generate-operations.mjs",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/client.test.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.13.4"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "openapi-typescript": "7.4.4",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
