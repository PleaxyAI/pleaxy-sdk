require 'rake/testtask'

Rake::TestTask.new(:test) do |t|
  t.libs << 'lib' << 'spec'
  t.pattern = 'spec/**/*_test.rb'
  t.warning = false
end

desc 'Load the quickstart example without running it (the SDK constants and methods it uses exist)'
task :examples do
  ruby '-Ilib', '-e', "ENV['PLEAXY_DRY_RUN'] = '1'; load 'examples/quickstart.rb'"
end

task default: %i[test examples]
